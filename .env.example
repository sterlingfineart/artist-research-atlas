# Copy to .env and export before starting (e.g. `set -a; source .env; set +a; npm start`)
PORT=3000
# Optional: grounded AI synthesis (any OpenAI-compatible API)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Recommended: free OpenAlex key (https://openalex.org/settings/api)
OPENALEX_API_KEY=
CONTACT_EMAIL=you@example.org
# Feedback page mail (SMTP). Without FEEDBACK_SMTP_HOST the /api/feedback
# endpoint answers 503 (mail not configured) and sends nothing.
# Port 465 = implicit TLS; other ports use STARTTLS when offered.
FEEDBACK_SMTP_HOST=
FEEDBACK_SMTP_PORT=587
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASS=
FEEDBACK_FROM=
FEEDBACK_TO=john@sterlingfineart.com
EUROPEANA_KEY=
USER_AGENT=ArtistResearchAtlas/1.0 (https://your-site.example; you@example.org)
